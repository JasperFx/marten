<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- One Bobcat line for the specs (DaemonTests) and the build's supervisor (JasperFx/bobcat#562).
         1.0.0-alpha.1 is ahead of the rc.1 that bobcat#562 originally planned to wait for. -->
    <BobcatVersion>1.0.0-alpha.1</BobcatVersion>

    <!-- Bobcat.Xunit 1.0 is built on xunit.v3 4.x over Microsoft.Testing.Platform 2.5.1, and the two
         xunit lines cannot share a test project. The rest of the repo stays on the xunit.v3 3.x pinned
         below; only the projects that take Bobcat.Xunit (DaemonTests and DaemonTests.ManualOnly, which
         references it) move, through VersionOverride on these two properties. Moving every suite to
         4.x is its own change: 14 AssemblyInfo.cs files carry
         [assembly: CollectionBehavior(DisableTestParallelization = true)], a compile error on 4.x. -->
    <BobcatXunitV3Version>4.0.2</BobcatXunitV3Version>
    <BobcatXunitRunnerVersion>4.0.1</BobcatXunitRunnerVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Alba" Version="8.2.0" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="8.2.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.13.10" />
    <PackageVersion Include="Bobcat.Supervisor" Version="0.27.3" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Confluent.Kafka" Version="2.3.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.0" />
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="1.2.39" />
    <PackageVersion Include="FSharp.Core" Version="9.0.100" />
    <PackageVersion Include="FSharp.SystemTextJson" Version="1.3.13" />
    <PackageVersion Include="Bobcat" Version="0.27.3" />
    <PackageVersion Include="Bobcat.Generators" Version="0.27.3" />
    <PackageVersion Include="Bobcat.Xunit" Version="0.27.3" />
    <PackageVersion Include="JasperFx" Version="2.90.2" />
    <PackageVersion Include="JasperFx.Events" Version="2.90.2" />
    <PackageVersion Include="JasperFx.Events.ComplianceTests" Version="2.90.2" />
    <!--
      No longer ahead of the rest of the JasperFx line. As of the 2.59.0 bump (marten#5305) the
      whole family moves together, and this note is kept for the history below. This package is
      analyzer-only,
      declares no dependencies, and Marten bundles its dll into Marten.nupkg (see
      _BundleEventsSourceGeneratorAnalyzer in Marten.csproj, marten#4557), so its version is
      independent of the runtime family's.

      2.42.1: jasperfx#637 (marten#5192) — the generator used to register an EventProjection's
      discovered published document types by emitting a parameterless constructor into the user's
      partial class. That is illegal on a type declaring a primary constructor, so
      `partial class MyProjection(ILogger logger) : EventProjection` failed to build with CS8862; and
      for a projection registered through AddProjectionWithServices the container calls the
      dependency-taking constructor, so the generated one never ran and the published types went
      silently unregistered. Registration now rides an override of ProjectionBase.PublishedTypes(),
      which does not care how the instance was constructed. The generator is otherwise byte-identical
      from 2.38.0 through 2.42.0, so this is an isolated swap of that one fix.
    -->
    <PackageVersion Include="JasperFx.Events.SourceGenerator" Version="2.90.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="JasperFx.SourceGenerator" Version="2.90.2" />
    <PackageVersion Include="Jil" Version="3.0.0-alpha2" />
    <PackageVersion Include="Lamar" Version="7.1.1" />
    <PackageVersion Include="Lamar.Microsoft.DependencyInjection" Version="15.0.0" />
    <PackageVersion Include="Marten" Version="8.2.1" />
    <PackageVersion Include="MemoryPack" Version="1.21.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="2.0.257" />
    <PackageVersion Include="Microsoft.AspNetCore.OData" Version="8.2.5" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR" Version="1.1.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.3.0" />
    <PackageVersion Include="Microsoft.FeatureManagement" Version="3.2.0" />
    <PackageVersion Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15" />
    <!-- Neovolve ships xunit v3 support under a distinct package id, not a major bump. -->
    <PackageVersion Include="Neovolve.Logging.Xunit.v3" Version="7.2.0" />
    <PackageVersion Include="NetTopologySuite" Version="2.5.0" />
    <PackageVersion Include="NetTopologySuite.IO.GeoJSON" Version="4.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="NodaTime.Serialization.JsonNet" Version="3.1.0" />
    <PackageVersion Include="NodaTime.Serialization.SystemTextJson" Version="1.1.2" />
    <PackageVersion Include="Npgsql" Version="9.0.4" />
    <PackageVersion Include="Npgsql.DependencyInjection" Version="9.0.2" />
    <PackageVersion Include="Npgsql.Json.NET" Version="9.0.4" />
    <PackageVersion Include="Npgsql.NetTopologySuite" Version="9.0.4" />
    <PackageVersion Include="Npgsql.NodaTime" Version="9.0.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Nuke.Common" Version="10.1.0" />
    <!-- Patched floors for vulnerable packages Nuke.Common 10.1.0 brings into build/build.csproj
         transitively (via Microsoft.Build.Tasks.Core and NuGet.Packaging). Build-only: nothing
         Marten ships depends on them. Drop once a Nuke release depends on patched versions.
           System.Security.Cryptography.Pkcs  GHSA-846f-f764-76mx (high)
           System.Security.Cryptography.Xml   GHSA-37gx-xxp4-5rgx (high)
           NuGet.Packaging                    GHSA-g4vj-cjjj-v7hg (low) -->
    <PackageVersion Include="NuGet.Packaging" Version="6.12.5" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="OpenTelemetry" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.19.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageVersion Include="Pgvector" Version="0.3.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Spectre.Console" Version="0.53.0" />
    <PackageVersion Include="StronglyTypedId" Version="1.0.0-beta08" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.3" />
    <PackageVersion Include="Vogen" Version="7.0.0" />
    <!-- Weasel 9.40.0, and the reason for the bump is weasel#676: the AdvisoryLock shutdown fix
         marten#5567 could not wait for a two-repository release chain is now upstream, so
         marten#5574 deletes the copy that was vendored into Marten.Events.Daemon.Coordination for
         9.46 and this consumes Weasel.Postgresql.AdvisoryLock again. The port kept the shape the
         vendored copy had — AdvisoryLockOptions.ReleaseTimeout is a settable PROPERTY and the
         4-argument constructor is untouched — so the de-vendoring is a revert, and the
         ReleaseTimeout = Projections.StopAndDrainTimeout wiring in ProjectionCoordinator survives
         it unchanged. The defect being routed around is still unfixed upstream in
         Patched.DistributedLock.Core 1.0.11; no bump exists.
         Also adopted here, as marten#5573: weasel#675 adds ParameterCount to
         Weasel.Core.ICommandBuilder, which CompiledQueryPlan implements. It ships with a default
         returning UnknownParameterCount (-1) — weasel#682, added after the first cut made a
         published Marten 9.45.0 fail with TypeLoadException on get_ParameterCount — so this is
         opt-in adoption, not a required fix.
         Two of 9.40.0 change migration OUTPUT, which is the part worth A/B'ing on any Weasel bump:
         weasel#677 writes a creation script in dependency order and weasel#681 guards a creation
         script's foreign key so the script can re-run. That second one is adjacent to marten#5536's
         `42710` on a re-applied event-store FK. Not Marten's concern but in the same range:
         weasel#666 adds a Weasel.Firebird provider, weasel#667 round-trips an Oracle identity
         column, weasel#668 ends a SQL Server batch after a column change, weasel#670 makes a SQL
         Server rollback undo check-constraint changes, and weasel#686 stops MySQL declaring a
         foreign key inline.
         9.37.0 before it was weasel#659:
         ApplyAllConfiguredChangesToDatabaseAsync released the global migration lock only on its
         SUCCESS paths, so a migration that threw left the lock held and locked every other replica out
         of migrating — while the node that stranded it reported nothing. Disposing the connection was
         not enough, because Npgsql resets a pooled connection when it is NEXT USED, not when it is
         returned, so the session lock outlived the apply for as long as that connection sat idle.
         That is marten#5529. Measured by running CoreTests twice against ONE database (the shape that
         reproduces it), fresh database per side: 9.36.0 gave pass 2 five failures, 9.37.0 gives one.
         The four that went away were always collateral — tests locked out because an earlier test's
         migration threw while holding the lock.
         The survivor is marten#5536 and is NOT a 9.37.0 regression: `42710: constraint
         "fkey_mt_events_stream_id" for relation "mt_events" already exists`, a re-apply re-adding the
         default event-store FK. A/B'd across both Weasel versions rather than attributed on suspicion,
         because 9.37.0 genuinely does change two migrations — it is present on 9.36.0 too and was
         merely invisible underneath the lock strand.
         Also in 9.37.0, none of it Marten's concern but two of it changes migration output: weasel#661
         reads SQL Server 2025 JSON indexes through sys.json_indexes (previously emitted as DROP INDEX
         on every apply), weasel#660 fixes Oracle descending indexes and co-migrated views, weasel#658
         makes TableDelta.HasChanges() answer instead of throwing for a table that does not exist yet,
         and weasel#664 stops the reconnection loop abandoning a connection per attempt.
         9.36.0 before it carried jasperfx#913's IAdvisoryLock.FindHolderAsync for Postgres
         (weasel#650) — which is what lets a Marten HotCold double-runner be named rather than only
         detected — and weasel#638, where changing a computed column's definition now drops and
         recreates the dependent indexes instead of silently dropping them.
         Must stay >= 9.20.2 (weasel#399), and >= 9.36.0's own floor of JasperFx 2.76.0, which
         9.40.0 still names and Marten already clears at 2.79.1.
         9.41.0 is two Native AOT changes on the identity seam, and both are additive:
         weasel#689 adds a non-generic IIdentification that the generic interface satisfies through
         default implementations, so a Type-keyed consumer (Marten's ProviderGraph) can hold a strategy
         without closing IIdentification<TDoc,TId> over (documentType, idType) at runtime. weasel#690
         adds Identifications, a non-generic entry point over all seven strategies whose ForValueType
         branches on RuntimeFeature.IsDynamicCodeSupported: the compiled generic where dynamic code
         is available, and a new reflection-only ReflectedValueTypeIdentification where it is not.
         That matters because ValueTypeIdentification<TDoc,TWrapper,TInner> is the one strategy whose
         arguments are not all reference types, so it is the one with no native code under AOT.
         Nothing is removed: ValueTypeIdentification<,,> and its constructor are untouched, so
         ClosedShapeRegistration still builds it directly. Marten does not consume either new seam yet;
         marten#5589 covers the Marten-side generics, which are a separate chain.
         9.42.0 carries three things, one of which touches every Marten table.
         weasel#696/#698 add PostgreSQL TABLE STORAGE PARAMETERS (fillfactor, autovacuum knobs) with a
         fluent API, written on create and tracked by the delta. Marten sets none of them, so the delta
         must stay quiet on every existing table — that is the risk this bump carries and the reason the
         schema-delta suites are the gate for it, not just a compile.
         weasel#694/#697 roots the Identifications factories' constructors with
         [DynamicDependency(PublicConstructors, typeof(Strategy<>))]. Five of the six threw under Native
         AOT: each closes a generic over the document type alone, which is a class and so shares a
         canonical body, but nothing statically referenced e.g. SequentialGuidIdentification<anything>, so
         ILC generated no body to share and MakeGenericType threw before Activator was reached. Marten does
         not consume Identifications yet (see the 9.41.0 note), so this is latent here rather than a fix to
         anything Marten currently hits — marten#5589/#5600 are the Marten-side chain.
         weasel#695 is a SQL Server AdvisoryLock fix and is Polecat's, not Marten's: Marten's advisory
         locks are PostgreSQL.
         9.43.0 (weasel#700/#701, configurable SQL Server advisory lock monitor) and 9.44.0
         (weasel#703/#704, re-runnable SQL Server function scripts) are SQL Server only: inert here.
         9.45.0 carries two fixes, and the first one was reported against Marten.
         weasel#706: db-patch wrote CREATE SCHEMA, and in the drop file `drop schema if exists ...
         CASCADE`, for every schema the application knows about. A Marten app's drop file for a one-table
         patch began with cascading drops of every Marten schema, the event store's included. The patch
         now creates only the changed schemas (SchemaMigration.ChangedSchemas) and the drop file drops no
         schema at all; it rolls back the objects the patch touched.
         weasel#707: TableBase.PrimaryKeyName is empty for a table without primary key columns (it was
         the default name built from no columns), and a primary key added to an existing table is now a
         PrimaryKeyDifference.Create that the PostgreSQL delta actually applies, instead of a table-level
         Create that only wrote CREATE TABLE IF NOT EXISTS. Removing a primary key no longer writes
         `add CONSTRAINT ... PRIMARY KEY ()`. Every Marten table declares its primary key, so the risk
         is the same as 9.42.0's: the schema-delta suites have to stay quiet on existing tables. -->
    <PackageVersion Include="Weasel.EntityFrameworkCore" Version="9.45.0" />
    <PackageVersion Include="Weasel.Postgresql" Version="9.45.0" />
    <PackageVersion Include="Weasel.Storage" Version="9.45.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="4.2.0" />
    <!-- The whole test suite is on xunit v3. VSTest stays the execution mode, so the
         Nuke targets and the GitHub workflows are unaffected. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <!-- EF Core packages - requires net9.0+ due to Npgsql 9.x compatibility -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.2" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>
  <!-- Framework-specific package versions -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="9.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>
</Project>