<Project Sdk="Microsoft.NET.Sdk">
    <!--
    marten#5820: stress harness for a composite projection rebuilt with one agent per tenant under
    per-tenant event partitioning, reporting the process's peak physical footprint. See README.md.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Marten\Marten.csproj" />
        <!-- A project reference to Marten doesn't bring the analyzer its package bundles; the projections' conventional
             Apply/Create methods are dispatched by it -->
        <PackageReference Include="JasperFx.Events.SourceGenerator" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
