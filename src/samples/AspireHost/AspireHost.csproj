<Project Sdk="Aspire.AppHost.Sdk/13.6.3">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>3504E417-C19C-4961-90CA-EB9CB217AE2C</UserSecretsId>
        <!-- The AppHost references no Marten, JasperFx or Weasel assembly, so the repository-wide global
             using aliases in src/Shared/DedupeAliases.cs have nothing to bind to -->
        <IncludeMartenDedupeAliases>false</IncludeMartenDedupeAliases>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\EventPublisher\EventPublisher.csproj" />
      <ProjectReference Include="..\AspireHeadlessTripService\AspireHeadlessTripService.csproj" />
    </ItemGroup>

</Project>
