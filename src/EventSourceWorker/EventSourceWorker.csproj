<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <UserSecretsId>dotnet-EventSourceWorker-01BE20B5-3C2D-434B-8822-823B56E3F401</UserSecretsId>
        <nullable>enable</nullable>

        <!-- This worker ProjectReferences DaemonTests, and xunit.v3 ships its entry-point
             generation in buildTransitive/, so the targets flow in here and emit a second
             Main alongside this project's own Program.cs (CS0017). This is not a test
             project; opt out of the generated entry point. -->
        <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\DaemonTests\DaemonTests.csproj" />
        <ProjectReference Include="..\Marten\Marten.csproj"/>
    </ItemGroup>
</Project>
