<Project Sdk="Microsoft.NET.Sdk">

    <!--
      #4796: F# projection fixtures referenced by EventSourcingTests. Because F# supports
      neither partial classes nor Roslyn source generators, F# projections must override the
      explicit Evolve / EvolveAsync / ApplyAsync methods instead of the conventional
      Apply/Create methods. This project exists so those authoring paths stay compiling and
      are exercised by the test suite against every change.
    -->

    <PropertyGroup>
        <!-- Directory.Build.props sets LangVersion=13.0 (a C# value); clear it for F#. -->
        <LangVersion></LangVersion>
        <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <!-- The F# SDK's implicit FSharp.Core reference tracks the SDK (10.x) and was
             winning over the version pinned in Directory.Packages.props, so this assembly
             carried a reference to FSharp.Core 10.0.0.0 while 9.0.0.0 was what actually
             got deployed. Nothing loaded this assembly's attributes under the old test
             host, so the mismatch stayed latent; it surfaces as a FileNotFoundException
             once anything reflects over the assembly. Take the pinned package instead. -->
        <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Projections.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Marten\Marten.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

</Project>
